# Publishes the names in mdns-names via avahi. -R skips the reverse (PTR) record,
# which /etc/avahi/hosts can't do (it fails with "Local name collision" for the
# host's own IP). Install: sudo systemctl link $PWD/mdns-names.service && sudo systemctl enable --now mdns-names
[Unit]
Description=Publish mDNS names for the caddy HTTPS front door
BindsTo=avahi-daemon.service
After=avahi-daemon.service network-online.target

[Service]
ExecStart=/bin/bash -c 'while read -r ip name; do avahi-publish -a -R "$name" "$ip" & done < <(grep -v "^#" /home/andre/raspberry/docker/caddy/mdns-names); wait -n'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
