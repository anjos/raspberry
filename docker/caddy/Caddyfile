# HTTPS for the web UIs, LAN only. Let's Encrypt certificates are obtained with
# the DNS-01 challenge through Cloudflare, so no inbound port is needed. The
# public records anjos.fyi and *.anjos.fyi point at the Pi's private address, so
# the names only lead anywhere from inside the LAN.
#
# Services keep talking to each other over plain HTTP by container hostname;
# these names are for people only. Each service below also needs a tile in
# site/index.html.
#
# Short aliases redirect to the full name, so each app keeps a single origin
# (one login).
#
# Reload after editing: docker exec caddy caddy reload --config /etc/caddy/Caddyfile

(cloudflare) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
}

# Index of all services
anjos.fyi {
	import cloudflare

	# Written by the status container
	@status path /status.json /health.json
	handle @status {
		root * /status
		header Cache-Control no-store
		file_server
	}

	handle {
		root * /etc/caddy/site
		file_server
	}
}

*.anjos.fyi {
	import cloudflare

	@plex host plex.anjos.fyi
	handle @plex {
		reverse_proxy host.docker.internal:32400
	}

	@qbittorrent host qbittorrent.anjos.fyi
	handle @qbittorrent {
		reverse_proxy qbittorrent:8123
	}

	@qbt host qbt.anjos.fyi
	handle @qbt {
		redir https://qbittorrent.anjos.fyi{uri}
	}

	@radarr host radarr.anjos.fyi
	handle @radarr {
		reverse_proxy radarr:7878 {
			# The app ignores X-Forwarded-Proto and redirects to http://
			header_down Location ^http:// https://
		}
	}

	@radr host radr.anjos.fyi
	handle @radr {
		redir https://radarr.anjos.fyi{uri}
	}

	@sonarr host sonarr.anjos.fyi
	handle @sonarr {
		reverse_proxy sonarr:8989 {
			# The app ignores X-Forwarded-Proto and redirects to http://
			header_down Location ^http:// https://
		}
	}

	@sonr host sonr.anjos.fyi
	handle @sonr {
		redir https://sonarr.anjos.fyi{uri}
	}

	@chaptarr host chaptarr.anjos.fyi
	handle @chaptarr {
		reverse_proxy chaptarr:8789
	}

	@chaptr host chaptr.anjos.fyi
	handle @chaptr {
		redir https://chaptarr.anjos.fyi{uri}
	}

	@prowlarr host prowlarr.anjos.fyi
	handle @prowlarr {
		reverse_proxy prowlarr:9696 {
			# The app ignores X-Forwarded-Proto and redirects to http://
			header_down Location ^http:// https://
		}
	}

	@prowlr host prowlr.anjos.fyi
	handle @prowlr {
		redir https://prowlarr.anjos.fyi{uri}
	}

	@zigbee2mqtt host zigbee2mqtt.anjos.fyi
	handle @zigbee2mqtt {
		reverse_proxy zigbee2mqtt:8080
	}

	@z2m host z2m.anjos.fyi
	handle @z2m {
		redir https://zigbee2mqtt.anjos.fyi{uri}
	}

	@homebridge host homebridge.anjos.fyi
	handle @homebridge {
		reverse_proxy host.docker.internal:8581
	}

	@hb host hb.anjos.fyi
	handle @hb {
		redir https://homebridge.anjos.fyi{uri}
	}

	# Unknown names: close the connection
	handle {
		abort
	}
}
